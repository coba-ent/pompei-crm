# Resultado del bootstrap OAuth local de Tiendanube (client_secret/access_token en claro)
/scripts/tn_oauth_bootstrap_resultado.json

# Datos reales del cliente / archivos sueltos de trabajo en la raíz
/*.csv
/*.png
/*.json
!/composer.json
!/package.json
!/package-lock.json

# Archivos subidos por el flujo de Importación (datos reales del cliente)
/public/imports

# Permisos locales de Claude Code (por maquina, no se versiona)
/.claude/settings.local.json

# Certificados/claves SSL sueltos en la raiz y backups de DB (nunca al repo)
/*.key
/*.crt
/*.csr
/.rnd
/backups
/*.pdf

# Bytecode de Python (deploy.py)
__pycache__/

# Dumps de base de datos con datos reales (migración VPS 02-03/08/2026)
/*.sql

# PDFs con datos fiscales reales
/public/arca/*.pdf

# Log de dev server de Vite
/vite-dev.log

# Scratch de trabajo (mapeo de SKUs), no código
/skus.txt

# Certificados ARCA en la ruta privada de Laravel (idem /storage/app/arca)
/storage/app/private/arca

